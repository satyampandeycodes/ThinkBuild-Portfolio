# ==============================================================================
# SMTP Server Configuration for Contact Form
# ==============================================================================
# These environment variables are used by the serverless /api/contact endpoint.
# In Vercel, add these under: Project Settings -> Environment Variables
# In local development, copy this file to .env and fill in your values.

# SMTP Server Host (e.g., smtp.gmail.com for Gmail, smtp.mailgun.org, etc.)
SMTP_HOST=smtp.gmail.com

# SMTP Server Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Your email address used for authenticating with the SMTP server
SMTP_USER=satyampandey.sp18@gmail.com

# Your SMTP password or Gmail App Password
# For Gmail: Enable 2FA, then generate an App Password at https://myaccount.google.com/apppasswords
SMTP_PASSWORD=

# The recipient email address where portfolio contact messages should be delivered
CONTACT_TO=satyampandey.sp18@gmail.com
